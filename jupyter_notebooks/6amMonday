def test_chart_display():
    """Test if charts can be displayed in current environment"""
    print("🧪 Testing Chart Display Capability...")
    
    # Test 1: Basic matplotlib
    try:
        import matplotlib.pyplot as plt
        plt.figure(figsize=(8, 4))
        plt.plot([1, 2, 3], [1, 4, 2], 'o-')
        plt.title('Matplotlib Test')
        plt.savefig('matplotlib_test.png')
        plt.show()
        plt.close()
        print("✅ Basic matplotlib works")
    except Exception as e:
        print(f"❌ Basic matplotlib failed: {e}")
    
    # Test 2: Seaborn
    try:
        import seaborn as sns
        import numpy as np
        data = np.random.randn(100)
        plt.figure(figsize=(8, 4))
        sns.histplot(data)
        plt.title('Seaborn Test')
        plt.savefig('seaborn_test.png')
        plt.show()
        plt.close()
        print("✅ Seaborn works")
    except Exception as e:
        print(f"❌ Seaborn failed: {e}")
    
    # Test 3: Plotly
    try:
        import plotly.express as px
        import pandas as pd
        df = pd.DataFrame({'x': [1, 2, 3, 4], 'y': [10, 11, 12, 13]})
        fig = px.scatter(df, x='x', y='y', title='Plotly Test')
        fig.write_html('plotly_test.html')
        fig.show()
        print("✅ Plotly works")
    except Exception as e:
        print(f"❌ Plotly failed: {e}")

